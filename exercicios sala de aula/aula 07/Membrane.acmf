Version "40.0-0";
Libraries "Modeler.acml", "SystemLibrary.acml";
Model Membrane

// Parameters
L as Length (Description: "Espessura da membrana [m]");
A as Area (Description: "Area da membrana [m^2]");
P_ratio as Fraction (Description: "Razao de pressao P Permeado / P de Alimentacao [-]");
K(ComponentList) as NoType (Description: "Permeabilidade [kmol/(s.m.Pa)]");

// Variaveis
J(ComponentList) as Flux_Mol (Description: "Fluxo molar atraves da membrana [kmol/(s.m^2)]");

// Conexoes
Inlet as Input MoleFractionPort;
Permeate as Output MoleFractionPort;
Retentate as Output MoleFractionPort;

// Equacoes
PermeateTemperature: Permeate.T = Inlet.T;
RetentateTemperature: Retentate.T = Inlet.T;
PermeatePressure: Permeate.P = P_ratio*Inlet.P;
RetentatePressure: Retentate.P = Inlet.P;
MolarFractionSumPermeate: sigma( foreach (comp in ComponentList) Permeate.z(comp) ) = 1;
MolarFractionSumRetentate: sigma( foreach (comp in ComponentList) Retentate.z(comp) ) = 1;

For comp in ComponentList do
ComponentMassBalance: Inlet.F*Inlet.z(comp) = Retentate.F*Retentate.z(comp) + Permeate.F*Permeate.z(comp);
Flux: J(comp) = K(comp)*(Inlet.P-Permeate.P)/L;
PermeateMolarFlow: Permeate.F*Permeate.z(comp) = J(comp)*A;
EndFor

//SYSTEM SECTION - WARNING: DO NOT EDIT
  Current_Icon : "System";
TYPE Membrane_T0 ROLE "ICON" text
Name = Membrane
lines = 35

sub main
call Path.Begin
'' <<Path:0
call Path.Box(-0.5,-0.5,3.5,-1.4,0,25600,1)
call Path.Line(-0.4,-0.9,3.3,-0.9,0,2)
'' >>
call Path.End
end sub

sub LabPos
call Label.at(1.5,-0.9)
end sub

sub ports
call Port.name("UniversalIN")
call Port.at(-0.502794,-0.506091)
call Port.direction(0)
call Port.name("UniversalOUT")
call Port.at(3.50104,-0.548836)
call Port.IOtype(1)
call Port.direction(0)
call Port.name("Inlet")
call Port.at(-0.503226,-0.784751)
call Port.direction(0)
call Port.name("Retentate")
call Port.at(3.50147,-0.763636)
call Port.IOtype(1)
call Port.direction(0)
call Port.name("Permeate")
call Port.at(1.52375,-1.41114)
call Port.IOtype(1)
call Port.direction(270)
end sub



endtext

Membrane_T0_I0 as Membrane_T0;
