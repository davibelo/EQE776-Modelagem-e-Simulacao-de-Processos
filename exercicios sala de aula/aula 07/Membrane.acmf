    If L.spec <> "Fixed" Then L.value = 3.000000e-03
    If P_ratio.spec <> "Fixed" Then P_ratio.value = 8.000000e-01
    If Permeate.F.spec <> "Fixed" Then Permeate.F.value = 2.364000e+01
