DYNAMICS
    DYNAMICS RESULTS=ON

TITLE 'SOUR WATER TREATMENT'

IN-UNITS MET VOLUME-FLOW='CUM/HR' ENTHALPY-FLO='GCAL/HR'  &
        HEAT-TRANS-C='KCAL/HR-SQM-K' PRESSURE='KG/SQCM'  &
        TEMPERATURE=C VOLUME=CUM DELTA-T=C HEAD=METER  &
        MOLE-ENTHALP='KCAL/MOL' MASS-ENTHALP='KCAL/KG' HEAT=GCAL  &
        MOLE-CONC='MOL/L' PDROP='KG/SQCM' SHORT-LENGTH=MM

DEF-STREAMS CONVEN ALL

DIAGNOSTICS
    TERMINAL SIM-LEVEL=4 CONV-LEVEL=4 COST-LEVEL=4 PROP-LEVEL=4  &
        ECON-LEVEL=4 STREAM-LEVEL=4 SYS-LEVEL=4

SIM-OPTIONS MASS-BAL-CHE=YES FREE-WATER=NO PARADIGM=SM  &
        EMISSION-CAL=NO

MODEL-OPTION
    RADFRAC MAXOL=200 ALGORITHM=STANDARD

DESCRIPTION "
    Components:
    H2O, CO2, H2S, NH3 are pre-selected

    Property Method:
    APISOUR

    Databanks: PURE40, Aqueous, Solids, Inorganics

    Flow basis for input:
    Std. liq. vol.

    Stream report composition:
    Std. liq. vol. flow


    "

DATABANKS 'APV140 PURE40' / 'APV140 AQUEOUS' / 'APV140 SOLIDS' &
         / 'APV140 INORGANIC' / 'APESV140 AP-EOS' /  &
        'NISTV140 NIST-TRC' / NOASPENPCD

PROP-SOURCES 'APV140 PURE40' / 'APV140 AQUEOUS' /  &
        'APV140 SOLIDS' / 'APV140 INORGANIC' / 'APESV140 AP-EOS' &
         / 'NISTV140 NIST-TRC'

COMPONENTS
    CO2 CO2 /
    H2S H2S /
    NH3 H3N /
    H2O H2O

PC-CALC
    PROPS API-METH

ADA-SETUP
    ADA-SETUP PROCEDURE=REL9

SOLVE
    RUN-MODE MODE=SIM

FLOWSHEET
    BLOCK T1 IN=8 23 OUT=11 14

PROPERTIES GPSWAT SOLU-WATER=3
    PROPERTIES APISOUR / NRTL / PENG-ROB / SRK

PROP-DATA PRKBV-1
    IN-UNITS MET VOLUME-FLOW='CUM/HR' ENTHALPY-FLO='GCAL/HR'  &
        HEAT-TRANS-C='KCAL/HR-SQM-K' PRESSURE='KG/SQCM'  &
        TEMPERATURE=C VOLUME=CUM DELTA-T=C HEAD=METER  &
        MOLE-ENTHALP='KCAL/MOL' MASS-ENTHALP='KCAL/KG' HEAT=GCAL  &
        MOLE-CONC='MOL/L' PDROP='KG/SQCM' SHORT-LENGTH=MM
    PROP-LIST PRKBV
    BPVAL CO2 H2S .0974000000 0.0 0.0 -273.1500000 726.8500000
    BPVAL H2S CO2 .0974000000 0.0 0.0 -273.1500000 726.8500000
    BPVAL CO2 H2O .1200000000 0.0 0.0 -273.1500000 726.8500000
    BPVAL H2O CO2 .1200000000 0.0 0.0 -273.1500000 726.8500000
    BPVAL H2S H2O .0400000000 0.0 0.0 -273.1500000 726.8500000
    BPVAL H2O H2S .0400000000 0.0 0.0 -273.1500000 726.8500000
    BPVAL NH3 H2O -.2589000000 0.0 0.0 -273.1500000  &
        726.8500000
    BPVAL H2O NH3 -.2589000000 0.0 0.0 -273.1500000  &
        726.8500000

PROP-SET COMPFLOW VLSTD UNITS='BBL/DAY' SUBSTREAM=MIXED PHASE=T  &
        BASIS=WET

PROP-SET DRYPROPS VLSTDMX APISTD SGSTD WAT FLPT-API RVP-API  &
        VLSTD UNITS='BBL/DAY' SUBSTREAM=MIXED BASIS=DRY

PROP-SET LSTRPROP VOLFLMX CPMX MUMX VLSTDMX UNITS='BBL/HR'  &
        'BTU/LB-R' 'CP' 'BBL/DAY' SUBSTREAM=MIXED PHASE=L

PROP-SET VSTRPROP VOLFLMX VVSTDMX CPMX RHOMX MWMX UNITS= &
        'CUFT/HR' 'BTU/LB-R' 'LB/CUFT' SUBSTREAM=MIXED PHASE=V

STREAM 8
    SUBSTREAM MIXED TEMP=122. PRES=8.3
    MASS-FLOW CO2 0. / H2S 161. / NH3 151. / H2O 49683.

STREAM 23
    SUBSTREAM MIXED TEMP=100.7 PRES=11.5 <KG/SQCMG>
    MASS-FLOW H2O 2937.

BLOCK T1 RADFRAC
    SUBOBJECTS PUMPAROUND = P-1
    PARAM NSTAGE=30 NPA=1 ALGORITHM=STANDARD EFF=MURPHREE  &
        INIT-OPTION=STANDARD MAXOL=200 DAMPING=NONE
    PARAM2 SALTS=INCLUDE STATIC-DP=YES
    COL-CONFIG CONDENSER=NONE CA-CONFIG=INT-1
    RATESEP-ENAB CALC-MODE=EQUILIBRIUM
    PUMPAROUND P-1 2 1 MASS-FLOW=7000. TEMP=60.  &
        PRES=6. <kg/sqcmg> VAPOR-STAGE=1
    FEEDS 8 14 ABOVE-STAGE / 23 7
    PRODUCTS 11 1 V / 14 30 L
    P-SPEC 1 6.
    COL-SPECS QN=2.12 DP-COL=0.2
    T-EST 1 116.5 / 2 153.9 / 3 146.2 / 4 146. / 5  &
        146.7 / 6 151.5
    L-EST 1 610.3 <kmol/Mhr> / 2 661.4 <kmol/Mhr> / 3  &
        3584. <kmol/Mhr> / 4 3583. <kmol/Mhr> / 5  &
        3589. <kmol/Mhr> / 6 3572. <kmol/Mhr>
    V-EST 1 2.93E-08 / 2 2.93E-08 / 3 2.93E-08 / 4 11.99 /  &
        5 11.81 / 6 17.65
    X-EST 1 H2S 0.005547 / 1 NH3 0.003709 / 1 H2O 0.9907 /  &
        3 H2S 0.003265 / 3 NH3 0.004267 / 3 H2O 0.9925 /  &
        6 H2S 0.002345 / 6 NH3 0.004233 / 6 H2O 0.9934
    Y-EST 1 H2S 0.01103 / 1 NH3 0.01849 / 1 H2O 0.9705 /  &
        3 H2S 0.01857 / 3 NH3 0.02117 / 3 H2O 0.9603 / 6  &
        H2S 0.1688 / 6 NH3 0.02041 / 6 H2O 0.8107
    PROPERTIES PENG-ROB FREE-WATER=STEAM-TA SOLU-WATER=3  &
        TRUE-COMPS=YES
    BLOCK-OPTION FLASH-METHOD=INSIDE-OUT
    STEFF-SEC SECNO=1 1 30 0.7
    PA-UTL P-1 U-2
    UTILITIES REB-UTIL=U-1

UTILITY U-1 GENERAL
    DESCRIPTION  &
        'MEDIUM PRESSURE STEAM, INLET TEMP=175 C, OUTLET TEMP=174 C, PRES=127 PSIA'
    COST ENERGY-PRICE=2.2E-06 <$/KJ>
    PARAM UTILITY-TYPE=STEAM TIN=175. TOUT=174. VFRAC=1.  &
        VFR-OUT=0. CALOPT=FLASH MIN-TAPP=10. CALCCO2=NO  &
        HTC=0.0216 <GJ/HR-SQM-C>

UTILITY U-2 GENERAL
    DESCRIPTION 'COOLING WATER, INLET TEMP=20 C, OUTLET TEMP=25 C'
    COST ENERGY-PRICE=2.12E-07 <$/KJ>
    PARAM UTILITY-TYPE=WATER PRES=1. <ATM> PRES-OUT=1. <ATM>  &
        TIN=20. TOUT=25. CALOPT=FLASH MIN-TAPP=5. CALCCO2=NO  &
        HTC=0.0135 <GJ/HR-SQM-C>

EO-CONV-OPTI

CALCULATOR C-1
    DEFINE SOUT MASS-FLOW STREAM=11 SUBSTREAM=MIXED  &
        COMPONENT=H2S UOM="KG/HR"
    DEFINE SIN MASS-FLOW STREAM=8 SUBSTREAM=MIXED COMPONENT=H2S  &
        UOM="KG/HR"
    DEFINE SRECOVER PARAMETER 1 PHYS-QTY=MASSFRAC UOM= &
        "MASS-PERCENT" INIT-VAL=0.
    DEFINE NH3IN MASS-FLOW STREAM=8 SUBSTREAM=MIXED  &
        COMPONENT=NH3 UOM="KG/HR"
    DEFINE NH3OUT MASS-FLOW STREAM=11 SUBSTREAM=MIXED  &
        COMPONENT=NH3 UOM="KG/HR"
    DEFINE NH3LOSS PARAMETER 2 PHYS-QTY=MASSFRAC UOM= &
        "MASS-PERCENT" INIT-VAL=0.
F     SRECOVER=SOUT/SIN
F     NH3LOSS=NH3OUT/NH3IN
    READ-VARS SOUT SIN NH3IN NH3OUT
    WRITE-VARS SRECOVER NH3LOSS
    EXECUTE AFTER BLOCK T1

SENSITIVITY QREB
    DEFINE H2SGAS MASS-FRAC STREAM=11 SUBSTREAM=MIXED  &
        COMPONENT=H2S
    DEFINE NH3GAS MASS-FRAC STREAM=11 SUBSTREAM=MIXED  &
        COMPONENT=NH3
    DEFINE WATERGAS MASS-FRAC STREAM=11 SUBSTREAM=MIXED  &
        COMPONENT=H2O
    DEFINE H2SWATER MASS-FRAC STREAM=14 SUBSTREAM=MIXED  &
        COMPONENT=H2S
    DEFINE NH3WATER MASS-FRAC STREAM=14 SUBSTREAM=MIXED  &
        COMPONENT=NH3
    DEFINE TBOT STREAM-VAR STREAM=11 SUBSTREAM=MIXED  &
        VARIABLE=TEMP UOM="C"
    DEFINE TTOP STREAM-VAR STREAM=14 SUBSTREAM=MIXED  &
        VARIABLE=TEMP UOM="C"
    TABULATE 1 "H2SGAS"
    TABULATE 2 "NH3GAS"
    TABULATE 3 "WATERGAS"
    TABULATE 4 "H2SWATER"
    TABULATE 5 "NH3WATER"
    TABULATE 6 "TBOT"
    TABULATE 7 "TTOP"
    VARY BLOCK-VAR BLOCK=T1 VARIABLE=QN SENTENCE=COL-SPECS UOM= &
        "Gcal/hr"
    RANGE OPT-LIST=LOGARITHMIC LOWER="1.5" UPPER="3.5"  &
        NPOINT="10"

STREAM-REPOR MOLEFLOW STDVOLFLOW STDVOLFRAC PROPERTIES=VSTRPROP  &
        LSTRPROP DRYPROPS COMPFLOW

PROPERTY-REP PCES
;
